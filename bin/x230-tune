#!/usr/bin/env python3
"""x230-tune — X230 服务器针对性优化（幂等，可反复跑）

做什么：
  1. 清理 pacman 包缓存（保留最近 2 个版本）
  2. 清理 coredump
  3. journald 上限 200MB（防止日志无限增长）
  4. 清理 Chromium 三个 profile 的缓存目录（不动登录态）
  5. vm.swappiness 180 → 100（zram 场景更稳，减少无效换出）
  6. 关掉空跑的 docker + containerd（0 容器时；随时可 systemctl enable --now docker 恢复）
  7. 清掉 failed 状态的 unit（agy-burn 等）
用法:
  x230-tune            # 只审计，打印现状与将执行的动作
  x230-tune --apply    # 真正执行
  x230-tune --no-docker  # 不动 docker
"""
import argparse
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")


def sh(cmd, timeout=120, check=False):
    r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=timeout)
    if check and r.returncode != 0:
        raise RuntimeError(f"{cmd}: {r.stderr[:200]}")
    return r.returncode, (r.stdout or "") + (r.stderr or "")


def du_mb(path):
    try:
        out = sh(["du", "-sm", path], timeout=60)[1].split()[0]
        return int(out)
    except Exception:
        return 0


def stat():
    st = {}
    st["disk_free_g"] = round(shutil.disk_usage("/").free / 1024 ** 3, 1)
    mem = {l.split(":")[0]: int(l.split(":")[1].split()[0]) for l in open("/proc/meminfo")}
    st["mem_avail_g"] = round(mem["MemAvailable"] / 1024 ** 2, 2)
    st["swap_used_mb"] = round((mem["SwapTotal"] - mem["SwapFree"]) / 1024)
    st["pacman_cache_mb"] = du_mb("/var/cache/pacman/pkg")
    m = re.search(r"take up ([\d.]+)M", sh("journalctl --disk-usage")[1])
    st["journal_mb"] = int(float(m.group(1))) if m else 0
    profiles = [".dsh/browser-profile", ".dsh/google-antigravity-profile", ".dsh/google-uzeyinox-profile"]
    st["chromium_cache_mb"] = sum(
        du_mb(f"{HOME}/{p}/{base}/{sub}")
        for p in profiles for base in ("Default", "") for sub in ("Cache", "Code Cache", "GPUCache"))
    st["swappiness"] = int(sh("sysctl -n vm.swappiness")[1].strip())
    st["coredump_mb"] = du_mb("/var/lib/systemd/coredump")
    st["docker_containers"] = sh("docker ps -aq 2>/dev/null | wc -l")[1].strip()
    st["docker_active"] = sh("systemctl is-active docker")[1].strip()
    st["thp"] = [x.strip("[]") for x in open("/sys/kernel/mm/transparent_hugepage/enabled").read().split()
                 if "[" in x][0]
    st["io_sched"] = [x.strip("[]") for x in open("/sys/block/sda/queue/scheduler").read().split()
                      if "[" in x][0]
    return st


def show(title, st):
    print(f"\n== {title} ==")
    for k, v in st.items():
        print(f"  {k:18} {v}")


def apply(no_docker=False, aggressive=False):
    before = stat()
    show("优化前", before)
    actions = []

    # 1) pacman 缓存：默认只报告（缓存的多是"当前已安装版本"，删了要重下）
    if aggressive and before["pacman_cache_mb"] > 500:
        sh("sudo paccache -rk0")
        actions.append(f"paccache -rk0 清空包缓存（{before['pacman_cache_mb']}MB）")
    elif before["pacman_cache_mb"] > 500:
        actions.append(f"pacman 缓存 {before['pacman_cache_mb']}MB 保留（都是已安装版本，删了要重下；需要空间加 --aggressive）")

    # 2) coredump 清理
    if before["coredump_mb"] > 1:
        sh("sudo rm -rf /var/lib/systemd/coredump/*")
        sh("sudo systemctl reset-failed 'systemd-coredump@*' 2>/dev/null")
        actions.append(f"清理 coredump（{before['coredump_mb']}MB）")

    # 3) journald 上限
    conf_dir = "/etc/systemd/journald.conf.d"
    conf = f"{conf_dir}/90-x230-size.conf"
    if not os.path.exists(conf):
        sh(f"sudo mkdir -p {conf_dir} && printf '[Journal]\\nSystemMaxUse=200M\\n' | sudo tee {conf} >/dev/null")
        sh("sudo systemctl restart systemd-journald")
        actions.append("journald 上限设为 200MB")

    # 4) 清 Chromium 缓存（不动 cookies/登录态）
    cleaned = 0
    for p in ("browser-profile", "google-antigravity-profile", "google-uzeyinox-profile"):
        for base in ("Default", ""):
            for sub in ("Cache", "Code Cache", "GPUCache"):
                d = f"{HOME}/.dsh/{p}/{base}/{sub}" if base else f"{HOME}/.dsh/{p}/{sub}"
                if os.path.isdir(d):
                    shutil.rmtree(d, ignore_errors=True)
                    cleaned += 1
    if cleaned:
        actions.append(f"清 Chromium 缓存目录 {cleaned} 个（登录态保留）")

    # 5) swappiness
    if before["swappiness"] > 100:
        sh("sudo sysctl -w vm.swappiness=100")
        sh("printf 'vm.swappiness=100\\n' | sudo tee /etc/sysctl.d/90-x230.conf >/dev/null")
        actions.append(f"vm.swappiness {before['swappiness']} → 100（已持久化）")

    # 6) 空跑的 docker
    if not no_docker and before["docker_containers"] in ("0", "0\n", ""):
        if sh("systemctl is-active docker")[1].strip() == "active":
            sh("sudo systemctl disable --now docker.socket docker containerd")
            actions.append("停用空跑的 docker/containerd/socket（恢复：sudo systemctl enable --now docker）")

    # 7) 清 failed 状态
    rc, out = sh("systemctl --failed --no-legend --no-pager")
    for line in out.splitlines():
        parts = [x for x in line.split() if x != "●"]
        unit = parts[0] if parts else ""
        if unit and unit.endswith(".service"):
            sh(f"sudo systemctl reset-failed {unit}")
            actions.append(f"reset-failed {unit}")

    print("\n== 执行动作 ==")
    for a in actions:
        print("  •", a)
    if not actions:
        print("  （无需改动）")

    after = stat()
    show("优化后", after)
    print("\n== 变化 ==")
    print(f"  磁盘可用   {before['disk_free_g']}G → {after['disk_free_g']}G "
          f"({'%.1f' % (after['disk_free_g'] - before['disk_free_g']) if after['disk_free_g'] >= before['disk_free_g'] else ''}G)")
    print(f"  交换占用   {before['swap_used_mb']}MB → {after['swap_used_mb']}MB")
    print(f"  pacman缓存 {before['pacman_cache_mb']}MB → {after['pacman_cache_mb']}MB")
    print(f"  journal    {before['journal_mb']}MB → {after['journal_mb']}MB")
    print(f"  Chromium缓存 {before['chromium_cache_mb']}MB → {after['chromium_cache_mb']}MB")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--no-docker", action="store_true")
    ap.add_argument("--aggressive", action="store_true", help="清空 pacman 包缓存（省空间，但以后要重下）")
    a = ap.parse_args()
    if a.apply:
        apply(no_docker=a.no_docker, aggressive=a.aggressive)
    else:
        show("现状审计（加 --apply 执行优化）", stat())


if __name__ == "__main__":
    main()
