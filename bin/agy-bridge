#!/usr/bin/env python3
"""agy-bridge — 把 Antigravity CLI(`agy`) 包装成 OpenAI 兼容接口，供 DSH 等客户端接入

端点:
  GET  /v1/models              列出 agy 可用模型
  POST /v1/chat/completions    单轮对话（把 messages 拼成一个 prompt 交给 `agy -p`）
  GET  /health                 健康检查

限制: agy 的 -p 是「一次性 agent 调用」，没有多轮会话状态，也不支持工具调用；
      这里把整段对话压平成一段文本，所以适合做「文本生成/第二意见」，
      不适合当需要 tool-calling 的编码主模型。

用法: agy-bridge [--port 8899] [--host 127.0.0.1] [--timeout 600]
"""
import argparse
import json
import os
import re
import subprocess
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOME = os.path.expanduser("~")
AGY = os.environ.get("AGY_BIN") or f"{HOME}/.local/bin/agy"
_models_cache = {"at": 0.0, "data": []}
_lock = threading.Lock()


def list_models():
    with _lock:
        if time.time() - _models_cache["at"] < 600 and _models_cache["data"]:
            return _models_cache["data"]
        try:
            out = subprocess.run([AGY, "models"], cwd="/tmp", capture_output=True,
                                 text=True, timeout=120).stdout
        except Exception:
            out = ""
        models = []
        for line in out.splitlines():
            m = re.match(r"^(\S+)\t(.+)$", line.strip())
            if m:
                models.append({"id": m.group(1), "object": "model", "created": int(time.time()),
                               "owned_by": "antigravity", "name": m.group(2).strip()})
        if models:
            _models_cache.update(at=time.time(), data=models)
        return models


def flatten(messages):
    parts = []
    for m in messages or []:
        role = (m.get("role") or "user").lower()
        content = m.get("content")
        if isinstance(content, list):  # 兼容 [{type:text,text:...}]
            content = "\n".join(c.get("text", "") for c in content if isinstance(c, dict))
        content = (content or "").strip()
        if not content:
            continue
        if role == "system":
            parts.append(f"[系统指令]\n{content}")
        elif role == "assistant":
            parts.append(f"[之前的回答]\n{content}")
        else:
            parts.append(f"[用户]\n{content}")
    return "\n\n".join(parts)


class Handler(BaseHTTPRequestHandler):
    server_version = "agy-bridge/1.0"
    timeout_s = 600

    def log_message(self, fmt, *args):
        print(f"{time.strftime('%F %T')} {self.address_string()} {fmt % args}", flush=True)

    def _json(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.startswith("/v1/models"):
            data = list_models()
            self._json(200, {"object": "list", "data": data})
        elif self.path.startswith("/health"):
            self._json(200, {"ok": True, "models": len(list_models())})
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        if not self.path.startswith("/v1/chat/completions"):
            self._json(404, {"error": {"message": "not found"}})
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            req = json.loads(self.rfile.read(n) or b"{}")
        except Exception as e:
            self._json(400, {"error": {"message": f"bad json: {e}"}})
            return

        model = req.get("model") or "gemini-3.8-flash-low"
        prompt = flatten(req.get("messages"))
        stream = bool(req.get("stream"))
        t0 = time.time()
        try:
            p = subprocess.run([AGY, "-p", prompt, "--model", model], cwd="/tmp",
                               capture_output=True, text=True, timeout=self.timeout_s)
            text = (p.stdout or "").strip()
            if p.returncode != 0 and not text:
                text = (p.stderr or "").strip() or f"(agy 退出码 {p.returncode})"
        except subprocess.TimeoutExpired:
            self._json(504, {"error": {"message": "agy timeout"}})
            return

        cid = f"chatcmpl-{uuid.uuid4().hex[:24]}"
        created = int(t0)
        if not stream:
            self._json(200, {
                "id": cid, "object": "chat.completion", "created": created, "model": model,
                "choices": [{"index": 0, "message": {"role": "assistant", "content": text},
                             "finish_reason": "stop"}],
                "usage": {"prompt_tokens": len(prompt) // 2, "completion_tokens": len(text) // 2,
                          "total_tokens": (len(prompt) + len(text)) // 2},
            })
            return

        # 简单 SSE：一次吐出整段（客户端兼容）
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()

        def send(obj):
            self.wfile.write(f"data: {json.dumps(obj, ensure_ascii=False)}\n\n".encode())
            self.wfile.flush()

        send({"id": cid, "object": "chat.completion.chunk", "created": created, "model": model,
              "choices": [{"index": 0, "delta": {"role": "assistant", "content": text},
                           "finish_reason": None}]})
        send({"id": cid, "object": "chat.completion.chunk", "created": created, "model": model,
              "choices": [{"index": 0, "delta": {}, "finish_reason": "stop"}]})
        self.wfile.write(b"data: [DONE]\n\n")
        self.wfile.flush()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=int(os.environ.get("AGY_BRIDGE_PORT", 8899)))
    ap.add_argument("--timeout", type=int, default=600)
    a = ap.parse_args()
    Handler.timeout_s = a.timeout
    srv = ThreadingHTTPServer((a.host, a.port), Handler)
    print(f"agy-bridge listening on http://{a.host}:{a.port}/v1 (models: {len(list_models())})", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
